{
    "name": "jonesrussell/laravel-redis-articles",
    "description": "Laravel package for ingesting articles from Redis pub/sub channels with deduplication, source tracking, and tag management",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Russell Jones",
            "email": "jones@russell.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/redis": "^12.0",
        "illuminate/console": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "JonesRussell\\LaravelRedisArticles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JonesRussell\\LaravelRedisArticles\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JonesRussell\\LaravelRedisArticles\\LaravelRedisArticlesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
