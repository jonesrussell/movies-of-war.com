[Unit]
Description=Movies of War North Cloud article subscriber
After=network.target
ConditionPathExists=/home/deployer/movies-of-war.com/current

[Service]
Type=simple
WorkingDirectory=/home/deployer/movies-of-war.com/current
ExecStart=/usr/bin/php artisan articles:subscribe
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
